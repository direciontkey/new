-- ============================================
-- MIXER / OVEN UPGRADES - FEATURE MODULE
-- ============================================

local Event = game:GetService("ReplicatedStorage").ZAP.ZAP_RELIABLE

local Feature = {
	NAME = "Mixer/Oven Upgrades",
	_AUTO_ENABLE = true,
	_enabled = false,
	_generation = 0,
	_connections = {},
	_instances = {},
	_tasks = {},
	_DROPDOWNS = {},
	_BUTTONS = {},
}

-- ============================================
-- FIRE
-- ============================================

function Feature._fire(bytes)
	if not Feature._enabled then
		return
	end

	local bufferData = buffer.create(#bytes)

	for i = 1, #bytes do
		buffer.writeu8(bufferData, i - 1, bytes[i])
	end

	Event:FireServer(bufferData, {})
end

