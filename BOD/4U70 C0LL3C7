-- ============================================
-- AUTO-COLLECT
-- ============================================

local Feature = {
	NAME = "Auto-Collect",
	_players = game:GetService("Players"),
	_userInputService = game:GetService("UserInputService"),
	_replicatedStorage = game:GetService("ReplicatedStorage"),
	_collectionService = game:GetService("CollectionService"),
	_enabled = false,
	_isCollecting = false,
	_generation = 0,
	_connections = {},
	_instances = {},
	_tasks = {},
	_player = nil,
	_inventory = nil,
	_interactables = nil,
	_autoCollectGUI = nil,
	_mainFrame = nil,
	_toggleButton = nil,
	_btnOutline = nil,
	_mainOutline = nil,
}

-- ============================================
-- SETTINGS
-- ============================================

Feature._collectSpeed = 0.1
Feature._collectRange = 15
Feature._collectRangeSq = Feature._collectRange * Feature._collectRange
Feature._toggleKey = Enum.KeyCode.F

-- ============================================
-- TRACKING HELPERS
-- ============================================

function Feature._safeDisconnect(connection)
	if connection then
		pcall(function()
			connection:Disconnect()
		end)
	end
end

function Feature._safeDestroy(instance)
	if instance then
		pcall(function()
			instance:Destroy()
		end)
	end
end

function Feature._safeCancel(thread)
	if thread then
		pcall(function()
			task.cancel(thread)
		end)
	end
end

function Feature._trackConnection(connection)
	if connection then
		table.insert(Feature._connections, connection)
	end
	return connection
end

function Feature._trackInstance(instance)
	if instance then
		table.insert(Feature._instances, instance)
	end
	return instance
end

function Feature._trackTask(thread)
	if thread then
		table.insert(Feature._tasks, thread)
	end
	return thread
end

-- ============================================
-- COLLECTION LOGIC
-- ============================================

function Feature._collectNearby(generation)
	if not Feature._enabled or Feature._generation ~= generation then
		return 0
	end

	local player = Feature._player
	local char = player and player.Character

	if not char or not char.PrimaryPart then
		return 0
	end

	local pos = char.PrimaryPart.Position
	local collected = 0
	local tagged = Feature._collectionService:GetTagged("InteractablePhysicsObject")

	for _, obj in ipairs(tagged) do
		if not Feature._enabled or Feature._generation ~= generation then
			break
		end

		if obj:IsA("Model") then
			local objPos = obj.PrimaryPart and obj.PrimaryPart.Position

			if objPos then
				local diff = objPos - pos

				if diff.X * diff.X + diff.Y * diff.Y + diff.Z * diff.Z < Feature._collectRangeSq then
					local data = Feature._interactables.getObjectByModel(obj)

					if data then
						pcall(function()
							Feature._inventory.pickupObject(data.uuid)
							collected = collected + 1
						end)
					end
				end
			end
		end
	end

	return collected
end

-- ============================================
-- BUTTON STATE
-- ============================================

function Feature._updateButtonState(enabled)
	local toggleButton = Feature._toggleButton
	local btnOutline = Feature._btnOutline
	local mainOutline = Feature._mainOutline

	if not toggleButton or not btnOutline or not mainOutline then
		return
	end

	if enabled then
		toggleButton.Text = "OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		btnOutline.Color = Color3.fromRGB(255, 100, 100)
		btnOutline.Transparency = 0.3
		mainOutline.Color = Color3.fromRGB(255, 100, 100)
		mainOutline.Transparency = 0.3
	else
		toggleButton.Text = "ON"
		toggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
		btnOutline.Color = Color3.fromRGB(255, 255, 255)
		btnOutline.Transparency = 0.5
		mainOutline.Color = Color3.fromRGB(255, 255, 255)
		mainOutline.Transparency = 0.4
	end
end

-- ============================================
-- COLLECTION TOGGLE
-- ============================================

function Feature._startCollecting()
	if Feature._isCollecting then
		return
	end

	Feature._isCollecting = true
	Feature._updateButtonState(true)

	local generation = Feature._generation

	Feature._trackTask(task.spawn(function()
		while Feature._enabled and Feature._isCollecting and Feature._generation == generation do
			Feature._collectNearby(generation)
			task.wait(Feature._collectSpeed)
		end
	end))
end

function Feature._stopCollecting()
	Feature._isCollecting = false
	Feature._updateButtonState(false)
end

function Feature._toggleCollect()
	if Feature._isCollecting then
		Feature._stopCollecting()
	else
		Feature._startCollecting()
	end
end

-- ============================================
-- BUILD GUI
-- ============================================

function Feature._createGUI()
	local playerGui = Feature._player:WaitForChild("PlayerGui")

	local autoCollectGUI = Feature._trackInstance(Instance.new("ScreenGui"))
	autoCollectGUI.Name = "AutoCollectGUI"
	autoCollectGUI.Parent = playerGui
	autoCollectGUI.IgnoreGuiInset = true

	local mainFrame = Feature._trackInstance(Instance.new("Frame"))
	mainFrame.Name = "MainFrame"
	mainFrame.Parent = autoCollectGUI
	mainFrame.Position = UDim2.new(0.5, 261, 0.5, 56)
	mainFrame.Size = UDim2.new(0, 46, 0, 46)
	mainFrame.AnchorPoint = Vector2.new(0, 0)
	mainFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
	mainFrame.BackgroundTransparency = 0.5
	mainFrame.BorderSizePixel = 0

	local corner = Feature._trackInstance(Instance.new("UICorner"))
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = mainFrame

	local mainOutline = Feature._trackInstance(Instance.new("UIStroke"))
	mainOutline.Name = "MainOutline"
	mainOutline.Color = Color3.fromRGB(255, 255, 255)
	mainOutline.Thickness = 1
	mainOutline.Transparency = 0.4
	mainOutline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	mainOutline.Parent = mainFrame

	local toggleButton = Feature._trackInstance(Instance.new("TextButton"))
	toggleButton.Name = "ToggleButton"
	toggleButton.Size = UDim2.new(0, 34, 0, 34)
	toggleButton.Position = UDim2.new(0, 6, 0, 6)
	toggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
	toggleButton.BackgroundTransparency = 0.3
	toggleButton.BorderSizePixel = 0
	toggleButton.Text = "ON"
	toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	toggleButton.TextSize = 16
	toggleButton.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Bold)
	toggleButton.Parent = mainFrame

	local btnCorner = Feature._trackInstance(Instance.new("UICorner"))
	btnCorner.CornerRadius = UDim.new(0, 4)
	btnCorner.Parent = toggleButton

	local btnOutline = Feature._trackInstance(Instance.new("UIStroke"))
	btnOutline.Name = "ButtonOutline"
	btnOutline.Color = Color3.fromRGB(255, 255, 255)
	btnOutline.Thickness = 1
	btnOutline.Transparency = 0.5
	btnOutline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	btnOutline.Parent = toggleButton

	local collectLabel = Feature._trackInstance(Instance.new("TextLabel"))
	collectLabel.Name = "CollectLabel"
	collectLabel.Size = UDim2.new(1, 0, 0, 15)
	collectLabel.Position = UDim2.new(0, 0, 1, 2)
	collectLabel.BackgroundTransparency = 1
	collectLabel.Text = "collect"
	collectLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	collectLabel.TextSize = 10
	collectLabel.Font = Enum.Font.Gotham
	collectLabel.TextXAlignment = Enum.TextXAlignment.Center
	collectLabel.Parent = mainFrame

	Feature._autoCollectGUI = autoCollectGUI
	Feature._mainFrame = mainFrame
	Feature._toggleButton = toggleButton
	Feature._btnOutline = btnOutline
	Feature._mainOutline = mainOutline

	Feature._trackConnection(toggleButton.MouseButton1Click:Connect(function()
		if not Feature._enabled then
			return
		end
		Feature._toggleCollect()
	end))
end

-- ============================================
-- INPUT
-- ============================================

function Feature._setupInput()
	local generation = Feature._generation

	Feature._trackConnection(Feature._userInputService.InputBegan:Connect(function(input, gp)
		if not Feature._enabled or Feature._generation ~= generation or gp then
			return
		end

		if input.KeyCode == Feature._toggleKey then
			Feature._toggleCollect()
		end
	end))
end

-- ============================================
-- ENABLE
-- ============================================

function Feature.enable()
	Feature.cleanup()

	Feature._generation = Feature._generation + 1
	Feature._enabled = true
	Feature._isCollecting = false
	Feature._player = Feature._players.LocalPlayer

	Feature._inventory = require(
		Feature._replicatedStorage.Client.Systems.Inventory
	)

	Feature._interactables = require(
		Feature._replicatedStorage.Client.Systems.Interactables
	)

	Feature._createGUI()
	Feature._setupInput()
end

-- ============================================
-- DISABLE
-- ============================================

function Feature.disable()
	Feature._enabled = false
	Feature._isCollecting = false
	Feature.cleanup()
end

-- ============================================
-- IS ENABLED
-- ============================================

function Feature.isEnabled()
	return Feature._enabled
end

-- ============================================
-- CLEANUP
-- ============================================

function Feature.cleanup()
	Feature._generation = Feature._generation + 1
	Feature._enabled = false
	Feature._isCollecting = false

	for _, connection in ipairs(Feature._connections) do
		Feature._safeDisconnect(connection)
	end

	for _, thread in ipairs(Feature._tasks) do
		Feature._safeCancel(thread)
	end

	for _, instance in ipairs(Feature._instances) do
		Feature._safeDestroy(instance)
	end

	table.clear(Feature._connections)
	table.clear(Feature._tasks)
	table.clear(Feature._instances)

	Feature._player = nil
	Feature._inventory = nil
	Feature._interactables = nil
	Feature._autoCollectGUI = nil
	Feature._mainFrame = nil
	Feature._toggleButton = nil
	Feature._btnOutline = nil
	Feature._mainOutline = nil
end

return Feature
