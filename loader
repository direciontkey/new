-- ============================================================
-- Theme Application
-- ============================================================

local function applyTheme(themeName, saveTheme)
	local success, result = pcall(function()
		return ThemeManager:applyTheme(themeName)
	end)

	if not success then
		warn("[Feature Manager] Failed to apply theme:", themeName, result)
		return false
	end

	local newTheme = result

	if type(newTheme) ~= "table" then
		local themeSuccess, fetchedTheme = pcall(function()
			return ThemeManager:getTheme(themeName)
		end)

		if not themeSuccess or type(fetchedTheme) ~= "table" then
			warn("[Feature Manager] ThemeManager returned an invalid theme:", themeName)
			return false
		end

		newTheme = fetchedTheme
	end

	Theme = newTheme
	CurrentThemeName = themeName

	-- ========================================================
	-- Main Window
	-- ========================================================

	if Main and Main.Parent then Main.BackgroundColor3 = Theme.Window.Background end
	if MainStroke and MainStroke.Parent then MainStroke.Color = Theme.Window.Outline end

	-- ========================================================
	-- Main Header
	-- ========================================================

	if Header and Header.Parent then Header.BackgroundColor3 = Theme.Header.Background end
	if Title and Title.Parent then Title.TextColor3 = Theme.Header.Title end

	-- ========================================================
	-- Main Content
	-- ========================================================

	if Content and Content.Parent then Content.BackgroundColor3 = Theme.Content.Background end

	-- ========================================================
	-- Theme Window
	-- ========================================================

	if ThemeWindow and ThemeWindow.Parent then ThemeWindow.BackgroundColor3 = Theme.Window.Background end
	if ThemeWindowStroke and ThemeWindowStroke.Parent then ThemeWindowStroke.Color = Theme.Window.Outline end
	if ThemeHeader and ThemeHeader.Parent then ThemeHeader.BackgroundColor3 = Theme.Header.Background end
	if ThemeHeaderTitle and ThemeHeaderTitle.Parent then ThemeHeaderTitle.TextColor3 = Theme.Header.Title end
	if ThemeContent and ThemeContent.Parent then ThemeContent.BackgroundColor3 = Theme.Content.Background end

	-- ========================================================
	-- Feature Bars
	-- ========================================================

	for _, data in ipairs(ThemeObjects.FeatureBars) do
		if data.Bar and data.Bar.Parent then data.Bar.BackgroundColor3 = Theme.FeatureBar.Background end
		if data.Name and data.Name.Parent then data.Name.TextColor3 = Theme.FeatureBar.Name end
		if data.Stroke and data.Stroke.Parent then data.Stroke.Color = Theme.FeatureBar.Outline end
	end

	-- ========================================================
	-- Toggles
	-- ========================================================

	for _, data in ipairs(ThemeObjects.Toggles) do
		if not data.Button or not data.Button.Parent then continue end

		local enabled = false
		local stateSuccess, stateResult = pcall(function()
			return data.Feature:isEnabled()
		end)

		if stateSuccess then enabled = stateResult == true end

		data.Button.BackgroundColor3 = enabled and Theme.CircleToggle.EnabledOuter or Theme.CircleToggle.DisabledOuter

		if data.Inner and data.Inner.Parent then
			data.Inner.BackgroundColor3 = enabled and Theme.CircleToggle.EnabledInner or Theme.CircleToggle.DisabledInner
			data.Inner.Size = enabled and INNER_ENABLED_SIZE or INNER_DISABLED_SIZE
		end
	end

	-- ========================================================
	-- Theme Items
	-- ========================================================

	for _, data in pairs(ThemeObjects.ThemeItems) do
		if data.Item and data.Item.Parent then
			data.Item.BackgroundColor3 = Theme.FeatureBar.Background
			data.Item.TextColor3 = Theme.FeatureBar.Name
		end

		if data.Stroke and data.Stroke.Parent then data.Stroke.Color = Theme.FeatureBar.Outline end
	end

	-- ========================================================
	-- Popups
	-- ========================================================

	for _, data in pairs(ThemeObjects.Popups) do
		if data.Frame and data.Frame.Parent then data.Frame.BackgroundColor3 = Theme.FeatureBar.Background end
		if data.Stroke and data.Stroke.Parent then data.Stroke.Color = Theme.FeatureBar.Outline end
	end

	-- ========================================================
	-- Mini Button
	-- ========================================================

	if MiniButton and MiniButton.Parent then
		MiniButton.BackgroundColor3 = Theme.Window.Background
		MiniButton.TextColor3 = Theme.Header.Title
	end

	if MiniButtonStroke and MiniButtonStroke.Parent then MiniButtonStroke.Color = Theme.Window.Outline end

	-- ========================================================
	-- Save Current Theme
	-- ========================================================

	if saveTheme and type(SaveManager.SetTheme) == "function" then
		local saveThemeSuccess, saveThemeError = pcall(function()
			SaveManager:SetTheme(CurrentThemeName)
		end)

		if not saveThemeSuccess then
			warn("[Feature Manager] Failed to update saved theme:", saveThemeError)
		end
	end

	return true
end

