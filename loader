local function createFeatureRow(rowIndex, featureIndexes)
	local validFeatures = {}

	for _, featureIndex in ipairs(featureIndexes) do
		local feature = Features[featureIndex]

		if feature then
			table.insert(validFeatures, {
				index = featureIndex,
				feature = feature,
			})

			placedFeatures[featureIndex] = true
		end
	end

	local featureCount = #validFeatures
	if featureCount == 0 then return end

	local Row = new("Frame", {
		Name = "Row_" .. rowIndex,
		Size = UDim2.new(1, 0, 0, FEATURE_HEIGHT),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = rowIndex,
		Parent = FeatureList,
	})

	if featureCount == 1 then
		createFeatureBar(Row, validFeatures[1].feature, validFeatures[1].index, 1, 1, 0)
		return
	end

	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Padding = UDim.new(0, FEATURE_GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = Row,
	})

	local width = 1 / featureCount
	local widthOffset = -(FEATURE_GAP * (featureCount - 1) / featureCount)

	for featureIndex, data in ipairs(validFeatures) do
		createFeatureBar(Row, data.feature, data.index, featureIndex, width, widthOffset)
	end
end

for _, row in ipairs(FeatureRows) do
	createFeatureRow(nextRowIndex, row)
	nextRowIndex += 1
end

for featureIndex = 1, #FEATURE_URLS do
