-- ============================================================
-- Load Saved Configuration
-- ============================================================

task.defer(function()
	local loaded, savedData = SaveManager:LoadAutoloadConfig()
	if not loaded then return end

	-- ========================================================
	-- Restore Saved Theme
	-- ========================================================

	local savedTheme

	if type(savedData) == "table" then
		savedTheme = savedData.theme
	end

	if not savedTheme and type(SaveManager.GetTheme) == "function" then
		local themeSuccess, themeResult = pcall(function()
			return SaveManager:GetTheme()
		end)

		if themeSuccess then savedTheme = themeResult end
	end

	if type(savedTheme) == "string" then
		local themeExists = ThemeManager:getTheme(savedTheme)

		if themeExists then
			applyTheme(savedTheme, false)
		end
	end

	-- ========================================================
	-- Restore Saved Feature States
	-- ========================================================

	if type(savedData) == "table" and type(savedData.objects) == "table" then
		for featureIndex, feature in pairs(Features) do
			local savedState = savedData.objects[tostring(featureIndex)]

			if savedState ~= nil then
				local targetState = savedState == true

				local stateSuccess, currentState = pcall(function()
					return feature:isEnabled()
				end)

				currentState = stateSuccess and currentState == true or false

				if currentState ~= targetState then
					local featureSuccess, featureError

					if targetState then
						featureSuccess, featureError = pcall(function()
							feature:enable()
						end)
					else
						featureSuccess, featureError = pcall(function()
							feature:disable()
						end)
					end

					if not featureSuccess then
						warn("[Feature Manager] Failed to restore feature " .. tostring(featureIndex) .. ":", featureError)
					end
				end
			end
		end
	end

	-- ========================================================
	-- Refresh Toggle Visuals
	-- ========================================================

	task.wait()

	for _, refresh in pairs(FeatureToggleRefreshers) do
		if type(refresh) == "function" then pcall(refresh) end
	end

	-- ========================================================
	-- Reapply Theme Once More
	-- ========================================================

	applyTheme(CurrentThemeName, false)
end)

-- ============================================================
-- Feature Cleanup
-- ============================================================

local function cleanupFeatures()
	for index, feature in pairs(Features) do
		if feature then
			local success, errorMessage = pcall(function()
				feature:disable()
			end)

			if not success then
				warn("[Feature Manager] Failed to disable feature " .. tostring(index), errorMessage)
			end

			success, errorMessage = pcall(function()
				feature:cleanup()
			end)

			if not success then
				warn("[Feature Manager] Failed to cleanup feature " .. tostring(index), errorMessage)
			end
		end
	end
end

-- ============================================================
-- Close
-- ============================================================

connectTap(CloseButton, function()
	setCameraBlocked(false)
	destroyAllTogglePopups()
	cleanupFeatures()
	ScreenGui:Destroy()
end)

