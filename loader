-- ============================================================
-- Resizing
-- ============================================================

local function makeResizable(handle, mode)
	local activeInput

	handle.InputBegan:Connect(function(input)
		if not isPrimaryInput(input) then return end
		if activeInput then return end

		local resizeStart = input.Position
		local startSize = Main.AbsoluteSize
		local startPosition = Main.Position

		if not beginGesture(function(moveInput)
			local delta = moveInput.Position - resizeStart
			local width = startSize.X
			local height = startSize.Y

			if mode == "Right" or mode == "Corner" then
				width = math.max(MIN_WINDOW_SIZE.X, startSize.X + delta.X)
			end

			if mode == "Bottom" or mode == "Corner" then
				height = math.max(MIN_WINDOW_SIZE.Y, startSize.Y + delta.Y)
			end

			Main.Size = UDim2.fromOffset(width, height)
			Main.Position = startPosition
		end) then
			return
		end

		activeInput = input
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input ~= activeInput then return end

		activeInput = nil
		endGesture()
	end)
end

