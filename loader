local Features = {}

local FEATURE_REQUIRED_METHODS = {
	"enable",
	"disable",
	"isEnabled",
	"cleanup",
}

local function validateFeature(feature)
	if type(feature) ~= "table" then
		return false, "Module did not return a table"
	end

	if type(feature.NAME) ~= "string" or feature.NAME == "" then
		return false, "Missing Feature.NAME"
	end

	for _, methodName in ipairs(FEATURE_REQUIRED_METHODS) do
		if type(feature[methodName]) ~= "function" then
			return false, "Missing Feature." .. methodName .. "()"
		end
	end

	return true
end

local function loadFeature(url, index)
	local success, result = pcall(function()
		local source = game:HttpGet(url)
		local loader = loadstring(source)

		if not loader then error("loadstring returned nil") end
		return loader()
	end)

	if not success then
		warn("[Feature Manager] Failed to load feature " .. index .. ":", result)
		return nil
	end

	local valid, errorMessage = validateFeature(result)

	if not valid then
		warn("[Feature Manager] Invalid feature " .. index .. ":", errorMessage)
		return nil
	end

	return result
end

for index, url in ipairs(FEATURE_URLS) do
	local feature = loadFeature(url, index)
	if feature then Features[index] = feature end
end

