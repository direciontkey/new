local function createToggle(parent, feature, featureIndex, onToggleDoubleClick, registerFeatureRefresher, initialState)
	local ToggleButton = new("TextButton", {
		Name = "Toggle",
		Size = CIRCLE_BUTTON_SIZE,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -FEATURE_INTERNAL_PADDING, 0.5, 0),
		BackgroundColor3 = Theme.CircleToggle.DisabledOuter,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = parent,
	})

	circle(ToggleButton)

	local Inner = new("Frame", {
		Name = "Inner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = INNER_DISABLED_SIZE,
		BackgroundColor3 = Theme.CircleToggle.DisabledInner,
		BorderSizePixel = 0,
		Parent = ToggleButton,
	})

	circle(Inner)

	local enabled = false
	local subscribers = {}

	local function animateState()
		if not ToggleButton.Parent then return end

		local outerColor = enabled and Theme.CircleToggle.EnabledOuter or Theme.CircleToggle.DisabledOuter
		local innerColor = enabled and Theme.CircleToggle.EnabledInner or Theme.CircleToggle.DisabledInner
		local innerSize = enabled and INNER_ENABLED_SIZE or INNER_DISABLED_SIZE

		TweenService:Create(ToggleButton, TOGGLE_OUTER_INFO, {BackgroundColor3 = outerColor}):Play()

		local burstTween = TweenService:Create(Inner, TOGGLE_BURST_INFO, {
			Size = INNER_BURST_SIZE,
			BackgroundColor3 = outerColor,
		})

		burstTween:Play()

		task.spawn(function()
			burstTween.Completed:Wait()
			if not ToggleButton.Parent then return end

			TweenService:Create(Inner, TOGGLE_SETTLE_INFO, {
				Size = innerSize,
				BackgroundColor3 = innerColor,
			}):Play()
		end)
	end

	local function notifySubscribers()
		for _, subscriber in ipairs(subscribers) do
			task.spawn(subscriber, enabled)
		end
	end

	local function setState(targetState, saveAfter)
		targetState = targetState == true
		if enabled == targetState then return end

		local success
		local errorMessage

		if targetState then
			success, errorMessage = pcall(function() feature:enable() end)
		else
			success, errorMessage = pcall(function() feature:disable() end)
		end

		if not success then
			warn("[Feature Manager] Failed to change " .. feature.NAME .. ":", errorMessage)
		end

		local stateSuccess, actualState = pcall(function()
			return feature:isEnabled()
		end)

		if stateSuccess then
			enabled = actualState == true
		else
			enabled = targetState
		end

		animateState()
		notifySubscribers()

		if saveAfter ~= false then SaveManager:Save() end
	end

	local function snapState(targetState)
		enabled = targetState == true

		local outerColor = enabled and Theme.CircleToggle.EnabledOuter or Theme.CircleToggle.DisabledOuter
		local innerColor = enabled and Theme.CircleToggle.EnabledInner or Theme.CircleToggle.DisabledInner
		local innerSize = enabled and INNER_ENABLED_SIZE or INNER_DISABLED_SIZE

		ToggleButton.BackgroundColor3 = outerColor
		Inner.BackgroundColor3 = innerColor
		Inner.Size = innerSize
	end

	local function refresh()
		local success, result = pcall(function()
			return feature:isEnabled()
		end)

		if success then snapState(result == true) end
	end

	connectTap(ToggleButton, function()
		setState(not enabled, true)
	end)

	local function onChanged(callback)
		table.insert(subscribers, callback)
	end

	if initialState ~= nil then
		snapState(initialState)
	else
		refresh()
	end

	if registerFeatureRefresher ~= false then FeatureToggleRefreshers[featureIndex] = refresh end

	table.insert(ThemeObjects.Toggles, {
		Index = featureIndex,
		Feature = feature,
		Button = ToggleButton,
		Inner = Inner,
	})

	return {
		Instance = ToggleButton,
		Feature = feature,
		Index = featureIndex,
		GetState = function() return enabled end,
		SetState = setState,
		SnapState = snapState,
		OnChanged = onChanged,
	}
end

-- ============================================================
-- Mirror Toggles
-- ============================================================

local function mirrorToggles(toggleA, toggleB)
	toggleB.SnapState(toggleA.GetState())

	toggleA.OnChanged(function(newState)
		if toggleB.GetState() ~= newState then toggleB.SetState(newState, false) end
	end)

	toggleB.OnChanged(function(newState)
		if toggleA.GetState() ~= newState then toggleA.SetState(newState, false) end
	end)
end

