-- ============================================================
-- Helpers
-- ============================================================

local function new(className, properties)
	local instance = Instance.new(className)
	local parent = properties.Parent

	for property, value in pairs(properties) do
		if property ~= "Parent" then
			instance[property] = value
		end
	end

	instance.Parent = parent
	return instance
end

local function corner(parent, scale, maxRadius)
	local uiCorner = new("UICorner", {Parent = parent})
	local lastRadius = -1

	local function update()
		if not parent.Parent then return end
		local size = parent.AbsoluteSize
		local shortest = math.min(size.X, size.Y)
		local radius = math.min(shortest * scale, maxRadius)

		if radius ~= lastRadius then
			lastRadius = radius
			uiCorner.CornerRadius = UDim.new(0, radius)
		end
	end

	update()
	parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	return uiCorner
end

local function circle(parent)
	return new("UICorner", {CornerRadius = UDim.new(1, 0), Parent = parent})
end

local MOUSE_BUTTON_1 = Enum.UserInputType.MouseButton1
local TOUCH = Enum.UserInputType.Touch
local MOUSE_MOVEMENT = Enum.UserInputType.MouseMovement

local function isPrimaryInput(input)
	local inputType = input.UserInputType
	return inputType == MOUSE_BUTTON_1 or inputType == TOUCH
end

local function isMoveInput(input)
	local inputType = input.UserInputType
	return inputType == MOUSE_MOVEMENT or inputType == TOUCH
end

-- ============================================================
-- Core Manager Loader
-- ============================================================

local function loadCoreManager(name, url)
	if type(url) ~= "string" or url == "" then
		warn("[Feature Manager] " .. name .. " URL is empty")
		return nil
	end

	local success, result = pcall(function()
		local source = game:HttpGet(url)
		if type(source) ~= "string" or source == "" then error("Remote source is empty") end

		local loader = loadstring(source)
		if not loader then error("loadstring returned nil") end

		return loader()
	end)

	if not success then
		warn("[Feature Manager] Failed to load " .. name .. ":", result)
		return nil
	end

	if type(result) ~= "table" then
		warn("[Feature Manager] " .. name .. " did not return a table")
		return nil
	end

	return result
end

