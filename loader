-- ============================================================
-- Unified Tap Detection
-- ============================================================

local function connectTap(button, callback, doubleCallback)
	local activeInput = nil
	local startPosition = nil
	local moved = false
	local lastTapTime = 0

	button.InputBegan:Connect(function(input)
		if not isPrimaryInput(input) then return end
		if activeInput then return end

		activeInput = input
		startPosition = input.Position
		moved = false
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not activeInput then return end

		local shouldTrack = false

		if activeInput.UserInputType == TOUCH then
			shouldTrack = input == activeInput
		else
			shouldTrack = input.UserInputType == MOUSE_MOVEMENT
		end

		if not shouldTrack then return end

		local delta = input.Position - startPosition

		if math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD then
			moved = true
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input ~= activeInput then return end

		activeInput = nil
		if moved then return end

		local now = os.clock()

		if doubleCallback and now - lastTapTime <= DOUBLE_CLICK_TIME then
			lastTapTime = 0
			doubleCallback()
		else
			lastTapTime = now
		end

		if callback then callback() end
	end)
end

