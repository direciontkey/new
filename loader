		FeatureIndex = featureIndex,
	}

	FeatureTogglePopups[featureIndex] = popupData
	ThemeObjects.Popups[featureIndex] = popupData

	local function destroyPopup()
		if destroyed then return end
		destroyed = true

		if FeatureTogglePopups[featureIndex] == popupData then
			FeatureTogglePopups[featureIndex] = nil
		end

		ThemeObjects.Popups[featureIndex] = nil

		if PopupScreenGui.Parent then PopupScreenGui:Destroy() end
	end

	local parentState = parentToggle.GetState()

	local PopupToggle = createToggle(PopupFrame, parentToggle.Feature, parentToggle.Index, nil, false, parentState)

	PopupToggle.Instance.AnchorPoint = Vector2.new(0.5, 0.5)
	PopupToggle.Instance.Position = UDim2.fromScale(0.5, 0.5)
	PopupToggle.Instance.ZIndex = 42

	local popupInner = PopupToggle.Instance:FindFirstChild("Inner")

	if popupInner then popupInner.ZIndex = 43 end

	PopupToggle.SnapState(parentState)
	mirrorToggles(parentToggle, PopupToggle)

	connectTap(PopupFrame, nil, function()
		destroyPopup()
	end)

	connectTap(PopupToggle.Instance, nil, function()
		destroyPopup()
	end)

	makeDraggable(PopupFrame, PopupFrame)
	makeDraggable(PopupToggle.Instance, PopupFrame)

	return PopupScreenGui
end

