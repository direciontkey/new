-- ============================================================
-- THEME MANAGER
-- ============================================================

local ThemeManager = {
	NAME = "Theme Manager",

	-- ================================
	-- Services
	-- ================================
	_httpService = game:GetService("HttpService"),

	-- ================================
	-- Runtime state
	-- ================================
	_enabled = false,
	_generation = 0,

	-- ================================
	-- Theme state
	-- ================================
	_themeConfig = nil,
	_currentTheme = nil,
	_currentThemeName = nil,

	-- ================================
	-- Theme object registry
	-- ================================
	_objects = {},
}

-- ============================================================
-- CONSTANTS
-- ============================================================

ThemeManager._config = {
	THEME_CONFIG_URL = "https://yaso.su/raw/r5ZueqRx",
}

ThemeManager._requiredThemeValues = {
	Window = {
		"Background",
		"Outline",
	},

	Header = {
		"Background",
		"Title",
	},

	Content = {
		"Background",
	},

	FeatureBar = {
		"Background",
		"Outline",
		"Name",
	},

	CircleToggle = {
		"EnabledOuter",
		"DisabledOuter",
		"EnabledInner",
		"DisabledInner",
	},
}

-- ============================================================
-- TRACKING HELPERS
-- ============================================================

function ThemeManager._trackConnection(connection)
	if connection then
		table.insert(ThemeManager._connections, connection)
	end

	return connection
end

function ThemeManager._trackInstance(instance)
	if instance then
		table.insert(ThemeManager._instances, instance)
	end

	return instance
end

function ThemeManager._trackTask(thread)
	if thread then
		table.insert(ThemeManager._tasks, thread)
	end

	return thread
end

function ThemeManager._safeDisconnect(connection)
	pcall(function()
		connection:Disconnect()
	end)
end

function ThemeManager._safeDestroy(instance)
	pcall(function()
		instance:Destroy()
	end)
end

function ThemeManager._safeCancel(thread)
	pcall(function()
		task.cancel(thread)
	end)
end

-- ============================================================
-- FEATURE HELPERS
-- ============================================================

function ThemeManager._validateTheme(theme)
	if type(theme) ~= "table" then
		return false, "Theme is not a table"
	end

	for sectionName, values in pairs(ThemeManager._requiredThemeValues) do
		local section = theme[sectionName]

		if type(section) ~= "table" then
			return false, "Missing section: " .. sectionName
		end

		for _, valueName in ipairs(values) do
			if section[valueName] == nil then
				return false, "Missing " .. sectionName .. "." .. valueName
			end
		end
	end

	return true
end

function ThemeManager._loadRemoteThemes()
	local url = ThemeManager._config.THEME_CONFIG_URL

	if type(url) ~= "string" or url == "" then
		warn("[Theme Manager] Theme URL is empty")
		return nil
	end

	local success, result = pcall(function()
		local source = game:HttpGet(url)

		if type(source) ~= "string" or source == "" then
			error("Remote theme response is empty")
		end

		local loader = loadstring(source)

		if not loader then
			error("loadstring returned nil")
		end

		return loader()
	end)

	if not success then
		warn("[Theme Manager] Failed to load remote themes:", result)
		return nil
	end

	if type(result) ~= "table" then
		warn("[Theme Manager] Theme config must return a table")
		return nil
	end

	local validThemes = {}
	local invalidCount = 0

	for themeName, themeData in pairs(result) do
		if type(themeName) == "string" then
			local valid, errorMessage = ThemeManager._validateTheme(themeData)

			if valid then
				validThemes[themeName] = themeData
			else
				invalidCount += 1

				warn(
					"[Theme Manager] Invalid theme '" .. themeName .. "':",
					errorMessage
				)
			end
		end
	end

	if next(validThemes) == nil then
		warn("[Theme Manager] Remote theme file contains no valid themes")
		return nil
	end

	if invalidCount > 0 then
		warn(
			"[Theme Manager] Skipped",
			invalidCount,
			"invalid theme(s)"
		)
	end

	return validThemes
end

function ThemeManager._getTheme(themeName)
	if type(ThemeManager._themeConfig) ~= "table" then
		return nil
	end

	local theme = ThemeManager._themeConfig[themeName]

	if not theme then
		return nil
	end

	local valid = ThemeManager._validateTheme(theme)

	if not valid then
		return nil
	end

	return theme
end

function ThemeManager._getInitialTheme()
	local defaultTheme = ThemeManager._getTheme("Default")

	if defaultTheme then
		return "Default", defaultTheme
	end

	local names = {}

	for themeName in pairs(ThemeManager._themeConfig) do
		if type(themeName) == "string" then
			table.insert(names, themeName)
		end
	end

	table.sort(names)

	for _, themeName in ipairs(names) do
		local theme = ThemeManager._getTheme(themeName)

		if theme then
			return themeName, theme
		end
	end

	return nil, nil
end

function ThemeManager._getThemeNames()
	local names = {}

	if type(ThemeManager._themeConfig) ~= "table" then
		return names
	end

	for themeName in pairs(ThemeManager._themeConfig) do
		if type(themeName) == "string" then
			table.insert(names, themeName)
		end
	end

	table.sort(names)

	return names
end

-- ============================================================
-- THEME REGISTRY
-- ============================================================

function ThemeManager._register(instance, properties)
	if not instance or type(properties) ~= "table" then
		return false
	end

	table.insert(ThemeManager._objects, {
		Instance = instance,
		Properties = properties,
	})

	if ThemeManager._currentTheme then
		ThemeManager._applyObject(
			instance,
			properties,
			ThemeManager._currentTheme
		)
	end

	return true
end

function ThemeManager._unregister(instance)
	for index = #ThemeManager._objects, 1, -1 do
		local data = ThemeManager._objects[index]

		if data.Instance == instance then
			table.remove(ThemeManager._objects, index)
		end
	end
end

function ThemeManager._clearRegistry()
	table.clear(ThemeManager._objects)
end

-- ============================================================
-- THEME VALUE RESOLUTION
-- ============================================================

function ThemeManager._getThemeValue(theme, path)
	if type(theme) ~= "table" then
		return nil
	end

	if type(path) ~= "string" then
		return nil
	end

	local current = theme

	for key in string.gmatch(path, "[^%.]+") do
		if type(current) ~= "table" then
			return nil
		end

		current = current[key]
	end

	return current
end

function ThemeManager._applyObject(instance, properties, theme)
	if not instance or not instance.Parent then
		return
	end

	if type(properties) ~= "table" then
		return
	end

	for property, themePath in pairs(properties) do
		local value = ThemeManager._getThemeValue(theme, themePath)

		if value ~= nil then
			pcall(function()
				instance[property] = value
			end)
		end
	end
end

function ThemeManager._applyRegisteredObjects()
	local objects = ThemeManager._objects
	local theme = ThemeManager._currentTheme

	if not theme then
		return
	end

	for index = #objects, 1, -1 do
		local data = objects[index]

		if not data
			or not data.Instance
			or not data.Instance.Parent
		then
			table.remove(objects, index)
		else
			ThemeManager._applyObject(
				data.Instance,
				data.Properties,
				theme
			)
		end
	end
end

-- ============================================================
-- THEME APPLICATION
-- ============================================================

function ThemeManager._applyTheme(themeName)
	if not ThemeManager._enabled then
		return false
	end

	local newTheme = ThemeManager._getTheme(themeName)

	if not newTheme then
		warn("[Theme Manager] Failed to apply theme:", themeName)
		return false
	end

	ThemeManager._currentTheme = newTheme
	ThemeManager._currentThemeName = themeName

	ThemeManager._applyRegisteredObjects()

	return true
end

-- ============================================================
-- THEME STATE ACCESS
-- ============================================================

function ThemeManager._getCurrentTheme()
	return ThemeManager._currentTheme
end

function ThemeManager._getCurrentThemeName()
	return ThemeManager._currentThemeName
end

function ThemeManager._getThemeConfig()
	return ThemeManager._themeConfig
end

-- ============================================================
-- ENABLE
-- ============================================================

function ThemeManager.enable()
	ThemeManager.cleanup()

	ThemeManager._generation += 1

	local generation = ThemeManager._generation

	ThemeManager._enabled = true

	local themes = ThemeManager._loadRemoteThemes()

	if not themes then
		ThemeManager._enabled = false
		return false
	end

	if generation ~= ThemeManager._generation
		or not ThemeManager._enabled
	then
		return false
	end

	ThemeManager._themeConfig = themes

	local themeName, theme = ThemeManager._getInitialTheme()

	if not theme then
		warn("[Theme Manager] No usable theme found")

		ThemeManager._enabled = false
		ThemeManager._themeConfig = nil

		return false
	end

	ThemeManager._currentThemeName = themeName
	ThemeManager._currentTheme = theme

	ThemeManager._applyRegisteredObjects()

	return true
end

-- ============================================================
-- DISABLE
-- ============================================================

function ThemeManager.disable()
	ThemeManager._enabled = false
	ThemeManager.cleanup()
end

-- ============================================================
-- ENABLED STATE
-- ============================================================

function ThemeManager.isEnabled()
	return ThemeManager._enabled == true
end

-- ============================================================
-- CLEANUP
-- ============================================================

function ThemeManager.cleanup()
	ThemeManager._enabled = false

	ThemeManager._generation += 1

	-- Cancel tracked tasks.
	for index = #ThemeManager._tasks, 1, -1 do
		local taskThread = ThemeManager._tasks[index]

		if taskThread then
			ThemeManager._safeCancel(taskThread)
		end

		ThemeManager._tasks[index] = nil
	end

	-- Disconnect every tracked connection.
	for index = #ThemeManager._connections, 1, -1 do
		local connection = ThemeManager._connections[index]

		if connection then
			ThemeManager._safeDisconnect(connection)
		end

		ThemeManager._connections[index] = nil
	end

	-- Destroy every feature-created instance.
	for index = #ThemeManager._instances, 1, -1 do
		local instance = ThemeManager._instances[index]

		if instance then
			ThemeManager._safeDestroy(instance)
		end

		ThemeManager._instances[index] = nil
	end

	-- Clear theme registry.
	ThemeManager._clearRegistry()

	-- Clear theme state.
	ThemeManager._themeConfig = nil
	ThemeManager._currentTheme = nil
	ThemeManager._currentThemeName = nil
end

-- ============================================================
-- INITIAL RESOURCE TABLES
-- ============================================================

ThemeManager._connections = {}
ThemeManager._instances = {}
ThemeManager._tasks = {}

return ThemeManager
