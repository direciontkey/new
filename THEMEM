-- ============================================
-- THEME MANAGER
-- ============================================

local HttpService = game:GetService("HttpService")

local ThemeManager = {
	NAME = "Theme Manager",

	THEME_CONFIG_URL = "https://yaso.su/raw/r5ZueqRx",

	_themes = {},
	_currentThemeName = nil,
	_currentTheme = nil,
	_initialized = false,
}

-- ============================================
-- Helpers
-- ============================================

local function isColor3(value)
	return typeof(value) == "Color3"
end

local function validateTheme(theme)
	if type(theme) ~= "table" then
		return false
	end

	local required = {
		Window = {
			"Background",
			"Outline",
		},

		Header = {
			"Background",
			"Title",
		},

		Content = {
			"Background",
		},

		FeatureBar = {
			"Background",
			"Outline",
			"Name",
		},

		CircleToggle = {
			"EnabledOuter",
			"DisabledOuter",
			"EnabledInner",
			"DisabledInner",
		},
	}

	for sectionName, fields in pairs(required) do
		local section = theme[sectionName]

		if type(section) ~= "table" then
			return false
		end

		for _, fieldName in ipairs(fields) do
			if not isColor3(section[fieldName]) then
				return false
			end
		end
	end

	return true
end

local function cloneTheme(theme)
	if type(theme) ~= "table" then
		return nil
	end

	local result = {}

	for key, value in pairs(theme) do
		if type(value) == "table" then
			result[key] = {}

			for subKey, subValue in pairs(value) do
				result[key][subKey] = subValue
			end
		else
			result[key] = value
		end
	end

	return result
end

-- ============================================
-- Load Theme Configuration
-- ============================================

local function loadThemes()
	local success, result = pcall(function()
		return game:HttpGet(ThemeManager.THEME_CONFIG_URL)
	end)

	if not success then
		warn("[Theme Manager] Failed to download theme configuration:", result)
		return false
	end

	local source = result

	local loadSuccess, loader = pcall(loadstring, source)

	if not loadSuccess or type(loader) ~= "function" then
		warn("[Theme Manager] Failed to compile theme configuration.")
		return false
	end

	local executeSuccess, themes = pcall(loader)

	if not executeSuccess then
		warn("[Theme Manager] Failed to execute theme configuration:", themes)
		return false
	end

	if type(themes) ~= "table" then
		warn("[Theme Manager] Theme configuration did not return a table.")
		return false
	end

	local validThemes = {}

	for themeName, themeData in pairs(themes) do
		if type(themeName) == "string" and validateTheme(themeData) then
			validThemes[themeName] = cloneTheme(themeData)
		end
	end

	if next(validThemes) == nil then
		warn("[Theme Manager] No valid themes were found.")
		return false
	end

	ThemeManager._themes = validThemes
	ThemeManager._initialized = true

	return true
end

-- ============================================
-- Initialization
-- ============================================

local function ensureInitialized()
	if ThemeManager._initialized then
		return true
	end

	return loadThemes()
end

-- ============================================
-- Public API
-- ============================================

function ThemeManager:getTheme(themeName)
	if not ensureInitialized() then
		return nil
	end

	if themeName == nil then
		return self._currentTheme
	end

	return self._themes[themeName]
end

function ThemeManager:getThemeNames()
	if not ensureInitialized() then
		return {}
	end

	local names = {}

	for themeName in pairs(self._themes) do
		table.insert(names, themeName)
	end

	table.sort(names, function(a, b)
		return a:lower() < b:lower()
	end)

	return names
end

function ThemeManager:getInitialTheme()
	if not ensureInitialized() then
		return nil, nil
	end

	-- Prefer Default when available.
	if self._themes.Default then
		self._currentThemeName = "Default"
		self._currentTheme = self._themes.Default

		return "Default", self._themes.Default
	end

	-- Otherwise use the first theme alphabetically.
	local names = self:getThemeNames()
	local firstName = names[1]

	if firstName then
		self._currentThemeName = firstName
		self._currentTheme = self._themes[firstName]

		return firstName, self._themes[firstName]
	end

	return nil, nil
end

function ThemeManager:applyTheme(themeName)
	if not ensureInitialized() then
		return nil
	end

	if type(themeName) ~= "string" then
		return nil
	end

	local theme = self._themes[themeName]

	if not theme then
		return nil
	end

	self._currentThemeName = themeName
	self._currentTheme = theme

	return theme
end

function ThemeManager:getCurrentThemeName()
	return self._currentThemeName
end

-- ============================================
-- Compatibility / Lifecycle
-- ============================================

function ThemeManager:enable()
	ensureInitialized()

	if not self._currentTheme then
		self:getInitialTheme()
	end

	return self._currentTheme ~= nil
end

function ThemeManager:disable()
	-- ThemeManager is core infrastructure.
	-- Do not destroy the loaded theme configuration.
	return true
end

function ThemeManager:isEnabled()
	return self._initialized
end

function ThemeManager:cleanup()
	self._themes = {}
	self._currentThemeName = nil
	self._currentTheme = nil
	self._initialized = false
end

-- ============================================
-- Initialize Immediately
-- ============================================

ensureInitialized()

return ThemeManager
