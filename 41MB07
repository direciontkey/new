	Feature._trackConnection(Feature._userInputService.InputChanged:Connect(function(input)
		if not Feature._enabled or not Feature._sliderDragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			Feature._updateSliderFromX(input.Position.X)
		end
	end))

	Feature._trackConnection(Feature._userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Feature._sliderDragging = false
			Feature._stopSliderCapture()
		end
	end))

	Feature._trackConnection(mainToggle.MouseButton1Click:Connect(function()
		Feature._setAimbotEnabled(not Feature._aimbotEnabled)
	end))

	Feature._trackConnection(fovToggle.MouseButton1Click:Connect(function()
		Feature._setFOVVisible(not Feature._showFOV)
	end))

	Feature._updateGUI()
end

-- ============================================
-- GUI CLEANUP
-- ============================================

function Feature._destroyGUI()
	Feature._stopSliderCapture()
	if Feature._guiElements.container then
		Feature._safeDestroy(Feature._guiElements.container)
	end
	Feature._guiElements = {}
end

-- ============================================
-- KEYBOARD INPUT
-- ============================================

function Feature._setupInput()
	Feature._trackConnection(Feature._userInputService.InputBegan:Connect(function(input, gameProcessed)
		if not Feature._enabled or gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.F then
			Feature._setAimbotEnabled(not Feature._aimbotEnabled)
		elseif input.KeyCode == Enum.KeyCode.C then
			Feature._setFOVVisible(not Feature._showFOV)
		end
	end))
end

-- ============================================
-- CHARACTER MONITORING
-- ============================================

function Feature._setupCharacterMonitor()
	local player = Feature._players.LocalPlayer
	if not player then
		return
	end
	local generation = Feature._generation
	Feature._trackConnection(player.CharacterAdded:Connect(function()
		if generation ~= Feature._generation or not Feature._enabled then
			return
		end
		local thread = task.spawn(function()
			task.wait(0.3)
			if generation ~= Feature._generation or not Feature._enabled then
				return
			end
			Feature._targetCache.part = nil
			Feature._targetCache.time = 0
			Feature._invalidateGunCache()
			Feature._invalidateMonsterCache()
			if Feature._aimbotEnabled then
				Feature._setFPP(true)
				Feature._startAimbot()
			end
		end)
		Feature._trackTask(thread)
	end))
end

-- ============================================
-- DRAWING CLEANUP
-- ============================================

function Feature._cleanupDrawing()
	Feature._hidePool(Feature._fovLines)
	Feature._hidePool(Feature._fovExtraLines)
	for index, drawing in pairs(Feature._modifiedDrawing) do
		if drawing then
			pcall(function()
				drawing:Remove()
			end)
		end
		Feature._modifiedDrawing[index] = nil
	end
	Feature._fovLines = {}
	Feature._fovExtraLines = {}
end

-- ============================================
-- LIFECYCLE
-- ============================================

function Feature.enable()
	Feature.cleanup()
	Feature._generation += 1
	Feature._enabled = true
	Feature._aimbotEnabled = false
	Feature._sliderDragging = false
	Feature._lastFireTime = 0
	Feature._playerCharacters = {}
	Feature._targetCache = {part = nil, time = 0}
	Feature._monsterCache = {}
	Feature._monsterCacheTime = 0
	Feature._monsterCacheDirty = true
	Feature._invalidateGunCache()
	Feature._isDrawingAvailable()
	Feature._createFOVDrawing()
	Feature._setupPlayerTracking()
	Feature._setupCharacterMonitor()
	Feature._setupInput()
	Feature._createGUI()
end

function Feature.disable()
	Feature._enabled = false
	Feature.cleanup()
end

function Feature.isEnabled()
	return Feature._enabled
end

function Feature.cleanup()
	Feature._enabled = false
	Feature._generation += 1
	Feature._aimbotEnabled = false
	Feature._sliderDragging = false
	Feature._lastFireTime = 0
	Feature._stopSliderCapture()
	Feature._stopAimbotLoop()
	Feature._setFPP(false)
	for index, connection in pairs(Feature._connections) do
		Feature._safeDisconnect(connection)
		Feature._connections[index] = nil
	end
	Feature._connections = {}
	for index, thread in pairs(Feature._tasks) do
		Feature._safeCancel(thread)
		Feature._tasks[index] = nil
	end
	Feature._tasks = {}
	Feature._destroyGUI()
	for index, instance in pairs(Feature._instances) do
		Feature._safeDestroy(instance)
		Feature._instances[index] = nil
	end
	Feature._instances = {}
	Feature._cleanupDrawing()
	Feature._playerCharacters = {}
	Feature._targetCache = {part = nil, time = 0}
	Feature._monsterCache = {}
	Feature._monsterCacheTime = 0
	Feature._monsterCacheDirty = true
	Feature._invalidateGunCache()
	Feature._fovLines = {}
	Feature._fovExtraLines = {}
	Feature._guiElements = {}
	Feature._aimbotRenderConnection = nil
	Feature._player = nil
end

return Feature
