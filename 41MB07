	_contextActionService = game:GetService("ContextActionService"),
	_runService = game:GetService("RunService"),
	_workspace = game:GetService("Workspace"),
	_replicatedStorage = game:GetService("ReplicatedStorage"),
	_enabled = false,
	_aimbotEnabled = false,
	_showFOV = false,
	_fov = 45,
	_fppEnabled = false,
	_lastFireTime = 0,
	_generation = 0,
	_connections = {},
	_instances = {},
	_tasks = {},
	_playerCharacters = {},
	_guiElements = {},
	_targetCache = {part = nil, time = 0},
	_monsterCache = {},
	_monsterCacheTime = 0,
	_monsterCacheDirty = true,
	_gunClient = nil,
	_gunEnv = nil,
	_gunFireFunction = nil,
	_gunCacheTime = 0,
	_modifiedDrawing = {},
	_drawingLibrary = nil,
	_hasDrawing = false,
	_sliderDragging = false,
	_aimbotRenderConnection = nil,
}

-- ============================================
-- CONFIGURATION
-- ============================================

Feature._config = {
	MAX_RANGE = 2500,
	CLOSE_RANGE = 60,
	CACHE_TTL = 0.30,
	EQUIP_ATTEMPTS = 3,
	WEAPON_NAME = "Nemesis",
	FOV_MIN = 5,
	FOV_MAX = 90,
	FIRE_RATE = 0.08,
	GUN_CACHE_TTL = 0.5,
	FOV_DRAWING_THICKNESS = 4,
	FOV_DRAWING_TRANSPARENCY = 1,
	FOV_CENTER_THICKNESS = 1,
	FOV_CENTER_TRANSPARENCY = 0.5,
	FOV_VISUAL_DISTANCE = 100,
	FOV_VISUAL_LENGTH = 0.75,
	EXACT_BOUNDARY_SEGMENTS = 96,
}

-- ============================================
-- CONSTANTS
-- ============================================

Feature._bossPatterns = {"SuperBoss_1", "SuperBoss_2", "SuperBoss_3"}
Feature._fireFunctions = {"OnFiring", "Fire", "Shoot", "v_u_81", "v_u_145"}
Feature._fovBoundaryColor = Color3.fromRGB(255, 80, 0)
Feature._fovCenterColor = Color3.fromRGB(255, 255, 255)
Feature._sliderActionName = "AimbotFOVSlider"
Feature._guiName = "AimbotGUI"

-- ============================================
-- TRACKING HELPERS
-- ============================================

function Feature._safeDisconnect(connection)
	if connection then
		pcall(function()
			connection:Disconnect()
		end)
	end
end

function Feature._safeDestroy(instance)
	if instance then
		pcall(function()
			instance:Destroy()
		end)
	end
end

function Feature._safeCancel(thread)
	if thread then
		pcall(function()
			task.cancel(thread)
		end)
	end
end

function Feature._trackConnection(connection)
	if connection then
		Feature._connections[#Feature._connections + 1] = connection
	end
	return connection
end

function Feature._trackInstance(instance)
	if instance then
		Feature._instances[#Feature._instances + 1] = instance
	end
	return instance
end

function Feature._trackTask(thread)
	if thread then
		Feature._tasks[#Feature._tasks + 1] = thread
	end
	return thread
end

-- ============================================
-- DRAWING LIBRARY
-- ============================================

function Feature._isDrawingAvailable()
	if Feature._drawingLibrary ~= nil then
		return Feature._hasDrawing
	end
	local success, result = pcall(function()
		return Drawing
	end)
	if success and type(result) == "table" then
		Feature._drawingLibrary = result
		Feature._hasDrawing = true
		return true
	end
	Feature._drawingLibrary = false
	Feature._hasDrawing = false
	return false
end

-- ============================================
-- DRAWING HELPERS
-- ============================================

function Feature._createFOVLine(thickness, transparency, color)
	if not Feature._hasDrawing then
		return nil
	end
	local success, line = pcall(function()
		local drawing = Feature._drawingLibrary.new("Line")
		drawing.Visible = false
		drawing.Thickness = thickness or 2
		drawing.Transparency = transparency or 1
		drawing.Color = color or Feature._fovBoundaryColor
		return drawing
	end)
	if success and line then
		Feature._modifiedDrawing[#Feature._modifiedDrawing + 1] = line
		return line
	end
	return nil
end

function Feature._createFOVDrawing()
	Feature._fovLines = {}
	Feature._fovExtraLines = {}
	if not Feature._isDrawingAvailable() then
		return
	end
	for _ = 1, Feature._config.EXACT_BOUNDARY_SEGMENTS do
		local line = Feature._createFOVLine(Feature._config.FOV_DRAWING_THICKNESS, Feature._config.FOV_DRAWING_TRANSPARENCY, Feature._fovBoundaryColor)
		if line then
			Feature._fovLines[#Feature._fovLines + 1] = line
		end
	end
	for _ = 1, 5 do
		local line = Feature._createFOVLine(Feature._config.FOV_CENTER_THICKNESS, Feature._config.FOV_CENTER_TRANSPARENCY, Feature._fovCenterColor)
		if line then
			Feature._fovExtraLines[#Feature._fovExtraLines + 1] = line
		end
	end
end

function Feature._hideLine(line)
	if not line then
		return
	end
	pcall(function()
		line.Visible = false
	end)
end

function Feature._hidePool(pool)
	if not pool then
		return
	end
	for index = 1, #pool do
		Feature._hideLine(pool[index])
	end
end

function Feature._setLine(line, from, to, visible, thickness, transparency, color)
	if not line then
		return
	end
	pcall(function()
		if from and to then
			line.From = from
			line.To = to
			line.Visible = visible
			if thickness then
				line.Thickness = thickness
			end
			if transparency then
				line.Transparency = transparency
			end
			if color then
				line.Color = color
			end
		else
			line.Visible = false
		end
	end)
end

-- ============================================
-- WORLD TO SCREEN
-- ============================================

function Feature._worldToScreen(camera, worldPosition)
	if not camera then
		return nil
	end
	local success, position, visible = pcall(function()
		return camera:WorldToViewportPoint(worldPosition)
	end)
	if not success or not visible then
		return nil
	end
	return Vector2.new(position.X, position.Y)
end

-- ============================================
-- FOV VISUALIZATION
-- ============================================

function Feature._getFOVWorldDistance(camera)
	local screenHeight = camera.ViewportSize.Y
	local visualLength = screenHeight * Feature._config.FOV_VISUAL_LENGTH
	local cameraFOV = math.rad(camera.FieldOfView)
	local distance = (visualLength / 2) / math.tan(cameraFOV / 2)
	return math.clamp(distance, 10, Feature._config.FOV_VISUAL_DISTANCE)
end

function Feature._getExactAngularBoundaryPoint(camera, rotation, distance)
	local cf = camera.CFrame
	local look = cf.LookVector
	local right = cf.RightVector
	local up = cf.UpVector
	local fovRadians = math.rad(Feature._fov)
	local rotationRadians = math.rad(rotation)
	local radial = right * math.cos(rotationRadians) + up * math.sin(rotationRadians)
	local direction = look * math.cos(fovRadians) + radial * math.sin(fovRadians)
	return cf.Position + direction * distance
end

function Feature._updateFOVVisualization()
	if not Feature._hasDrawing then
		return
	end
	local camera = Feature._workspace.CurrentCamera
	if not camera then
		Feature._hidePool(Feature._fovLines)
		Feature._hidePool(Feature._fovExtraLines)
		return
	end
	if not Feature._showFOV then
		Feature._hidePool(Feature._fovLines)
		Feature._hidePool(Feature._fovExtraLines)
		return
	end
	local distance = Feature._getFOVWorldDistance(camera)
	local points = {}
	for i = 0, Feature._config.EXACT_BOUNDARY_SEGMENTS do
		local rotation = (i / Feature._config.EXACT_BOUNDARY_SEGMENTS) * 360
		points[i + 1] = Feature._worldToScreen(camera, Feature._getExactAngularBoundaryPoint(camera, rotation, distance))
	end
	for i = 1, Feature._config.EXACT_BOUNDARY_SEGMENTS do
		local p1 = points[i]
		local p2 = points[i + 1]
		if p1 and p2 then
			Feature._setLine(Feature._fovLines[i], p1, p2, true, Feature._config.FOV_DRAWING_THICKNESS, Feature._config.FOV_DRAWING_TRANSPARENCY, Feature._fovBoundaryColor)
		else
			Feature._hideLine(Feature._fovLines[i])
		end
	end
	local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	local centerWorld = camera.CFrame.Position + camera.CFrame.LookVector * distance
	local centerScreen = Feature._worldToScreen(camera, centerWorld)
	Feature._setLine(Feature._fovExtraLines[1], center, centerScreen, centerScreen ~= nil, Feature._config.FOV_CENTER_THICKNESS, Feature._config.FOV_CENTER_TRANSPARENCY, Feature._fovCenterColor)
	for i = 2, #Feature._fovExtraLines do
		Feature._hideLine(Feature._fovExtraLines[i])
	end
end

-- ============================================
-- ANGLE / FOV CHECK
-- ============================================

function Feature._getAngleToTarget(targetPosition)
	local camera = Feature._workspace.CurrentCamera
	if not camera then
		return math.huge
	end
	local offset = targetPosition - camera.CFrame.Position
	local magnitude = offset.Magnitude
	if magnitude <= 0 then
		return 0
	end
	local direction = offset / magnitude
	local dot = math.clamp(direction:Dot(camera.CFrame.LookVector), -1, 1)
	return math.deg(math.acos(dot))
end

function Feature._isWithinFOV(targetPosition)
	if not Feature._showFOV then
		return true
	end
	return Feature._getAngleToTarget(targetPosition) <= Feature._fov
end

-- ============================================
-- PLAYER CHARACTER TRACKING
-- ============================================

function Feature._registerCharacter(character)
	if character then
		Feature._playerCharacters[character] = true
	end
end

function Feature._unregisterCharacter(character)
	if character then
		Feature._playerCharacters[character] = nil
	end
end

function Feature._setupPlayerTracking()
	for _, player in ipairs(Feature._players:GetPlayers()) do
		Feature._registerCharacter(player.Character)
		Feature._trackConnection(player.CharacterAdded:Connect(function(character)
			if not Feature._enabled then
				return
			end
			Feature._registerCharacter(character)
		end))
		Feature._trackConnection(player.CharacterRemoving:Connect(function(character)
			Feature._unregisterCharacter(character)
		end))
	end
	Feature._trackConnection(Feature._players.PlayerAdded:Connect(function(player)
		if not Feature._enabled then
			return
		end
		Feature._registerCharacter(player.Character)
		Feature._trackConnection(player.CharacterAdded:Connect(function(character)
			if not Feature._enabled then
				return
			end
			Feature._registerCharacter(character)
		end))
		Feature._trackConnection(player.CharacterRemoving:Connect(function(character)
			Feature._unregisterCharacter(character)
		end))
	end))
	Feature._trackConnection(Feature._players.PlayerRemoving:Connect(function(player)
		Feature._unregisterCharacter(player.Character)
	end))
end

function Feature._isPlayerCharacter(model)
	return Feature._playerCharacters[model] == true
end

-- ============================================
-- MONSTER DETECTION
-- ============================================

function Feature._getMonstersFolder()
	return Feature._workspace:FindFirstChild("Monsters")
end

function Feature._isMonsterModel(model)
	if not model or not model:IsA("Model") then
		return false
	end
	if Feature._isPlayerCharacter(model) then
		return false
	end
	local monstersFolder = Feature._getMonstersFolder()
	if not monstersFolder then
		return false
	end
	return model:IsDescendantOf(monstersFolder)
end

function Feature._invalidateMonsterCache()
	Feature._monsterCacheDirty = true
end

function Feature._getAllMonsters()
	local now = os.clock()
	if not Feature._monsterCacheDirty and now - Feature._monsterCacheTime < Feature._config.CACHE_TTL then
		return Feature._monsterCache
	end
	local monsters = {}
	local monstersFolder = Feature._getMonstersFolder()
	if monstersFolder then
		for _, object in ipairs(monstersFolder:GetDescendants()) do
			if object:IsA("Model") and Feature._isMonsterModel(object) then
				local humanoid = object:FindFirstChildWhichIsA("Humanoid", true)
				if humanoid and humanoid.Health > 0 then
					monsters[#monsters + 1] = {
						model = object,
						humanoid = humanoid,
					}
				end
			end
		end
	end
	Feature._monsterCache = monsters
	Feature._monsterCacheTime = now
	Feature._monsterCacheDirty = false
	return monsters
end

-- ============================================
-- TARGET PRIORITY
-- ============================================

function Feature._isBoss(modelName)
	for i = 1, #Feature._bossPatterns do
		if string.find(modelName, Feature._bossPatterns[i]) then
			return true
		end
	end
	return false
end

function Feature._getPriority(modelName, distance)
	local boss = Feature._isBoss(modelName)
	local close = distance <= Feature._config.CLOSE_RANGE
	if boss and close then
		return 1
	end
	if not boss and close then
		return 2
	end
	if boss then
		return 3
	end
	return 4
end

-- ============================================
-- TARGET ACQUISITION
-- ============================================

function Feature._getBestTarget()
	local now = os.clock()
	local player = Feature._players.LocalPlayer
	if not player then
		return nil
	end
	local character = player.Character
	if not character then
		return nil
	end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return nil
	end
	local cachedPart = Feature._targetCache.part
	if cachedPart and cachedPart.Parent and now - Feature._targetCache.time < 0.15 then
		local model = cachedPart:FindFirstAncestorOfClass("Model")
		if model then
			local humanoid = model:FindFirstChildWhichIsA("Humanoid", true)
			if humanoid and humanoid.Health > 0 and Feature._isWithinFOV(cachedPart.Position) then
				return cachedPart
			end
		end
	end
	local bestParts = {nil, nil, nil, nil}
	local bestDistances = {math.huge, math.huge, math.huge, math.huge}
	local rootPosition = rootPart.Position
	local monsters = Feature._getAllMonsters()
	for i = 1, #monsters do
		local entry = monsters[i]
		local model = entry.model
		local humanoid = entry.humanoid
		if model.Parent and humanoid.Health > 0 then
			local targetPart = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
			if targetPart then
				local offset = rootPosition - targetPart.Position
				local distance = offset.Magnitude
				if distance <= Feature._config.MAX_RANGE and Feature._isWithinFOV(targetPart.Position) then
					local priority = Feature._getPriority(model.Name, distance)
					if distance < bestDistances[priority] then
						bestDistances[priority] = distance
						bestParts[priority] = targetPart
					end
				end
			end
		end
	end
	for priority = 1, 4 do
		if bestParts[priority] then
			Feature._targetCache.part = bestParts[priority]
			Feature._targetCache.time = now
			return bestParts[priority]
		end
	end
	Feature._targetCache.part = nil
	Feature._targetCache.time = now
	return nil
end

-- ============================================
-- GUN CACHE
-- ============================================

function Feature._invalidateGunCache()
	Feature._gunClient = nil
	Feature._gunEnv = nil
	Feature._gunFireFunction = nil
	Feature._gunCacheTime = 0
end

function Feature._refreshGunCache(force)
	local player = Feature._players.LocalPlayer
	if not player then
		Feature._invalidateGunCache()
		return false
	end
	local character = player.Character
	if not character then
		Feature._invalidateGunCache()
		return false
	end
	local tool = character:FindFirstChildOfClass("Tool")
	if not tool then
		Feature._invalidateGunCache()
		return false
	end
	local gunClient = tool:FindFirstChild("GunClient") or tool:FindFirstChild("WeaponClient")
	if not gunClient then
		Feature._invalidateGunCache()
		return false
	end
	local now = os.clock()
	if not force and Feature._gunClient == gunClient and Feature._gunEnv and now - Feature._gunCacheTime < Feature._config.GUN_CACHE_TTL then
		return true
	end
	Feature._gunClient = gunClient
	Feature._gunEnv = nil
	Feature._gunFireFunction = nil
	Feature._gunCacheTime = now
	local success, env = pcall(function()
		return getsenv(gunClient)
	end)
	if not success or not env then
		return false
	end
	Feature._gunEnv = env
	for i = 1, #Feature._fireFunctions do
		local fn = env[Feature._fireFunctions[i]]
		if type(fn) == "function" then
			Feature._gunFireFunction = fn
			break
		end
	end
	return true
end

-- ============================================
-- GUN FIRE
-- ============================================

function Feature._triggerGunFire()
	if not Feature._refreshGunCache(false) then
		return false
	end
	local env = Feature._gunEnv
	local fireFunction = Feature._gunFireFunction
	if fireFunction then
		local success = pcall(fireFunction)
		if success then
			return true
		end
		Feature._invalidateGunCache()
		if Feature._refreshGunCache(true) then
			fireFunction = Feature._gunFireFunction
			if fireFunction then
				local retrySuccess = pcall(fireFunction)
				if retrySuccess then
					return true
				end
			end
		end
		Feature._invalidateGunCache()
		return false
	end
	if not env then
		Feature._invalidateGunCache()
		return false
	end
	local firingState = env.v_u_81
	if not firingState then
		Feature._invalidateGunCache()
		if Feature._refreshGunCache(true) then
			env = Feature._gunEnv
			firingState = env and env.v_u_81
		end
		if not firingState then
			return false
		end
	end
	firingState.Down = true
	firingState.Enabled = true
	firingState.Reloading = false
	local ammo = env.v_u_146
	if ammo and ammo.Mag and ammo.Mag <= 0 then
		ammo.Mag = 1
	end
	local generation = Feature._generation
	local thread = task.defer(function()
		if generation ~= Feature._generation or not Feature._enabled then
			return
		end
		if env and env.v_u_81 then
			env.v_u_81.Down = false
		end
	end)
	Feature._trackTask(thread)
	return true
end

-- ============================================
-- FPP
-- ============================================

function Feature._setFPP(enabled)
	local player = Feature._players.LocalPlayer
	local camera = Feature._workspace.CurrentCamera
	if not player or not camera then
		return
	end
	if enabled then
		Feature._fppEnabled = true
		pcall(function()
			player.CameraMode = Enum.CameraMode.LockFirstPerson
			player.CameraMinZoomDistance = 0.5
			player.CameraMaxZoomDistance = 0.5
			camera.CameraType = Enum.CameraType.Custom
		end)
		return
	end
	if not Feature._fppEnabled then
		return
	end
	Feature._fppEnabled = false
	local generation = Feature._generation
	local thread = task.spawn(function()
		if generation ~= Feature._generation then
			return
		end
		if not player or not player.Parent then
			return
		end
		local currentCamera = Feature._workspace.CurrentCamera
		if not currentCamera then
			return
		end
		pcall(function()
			player.CameraMode = Enum.CameraMode.Classic
			currentCamera.CameraType = Enum.CameraType.Custom
			player.CameraMinZoomDistance = 13.5
			player.CameraMaxZoomDistance = 13.5
		end)
		Feature._runService.RenderStepped:Wait()
		if generation ~= Feature._generation or not Feature._enabled then
			return
		end
		if not player or not player.Parent then
			return
		end
		pcall(function()
			player.CameraMinZoomDistance = 13.5
			player.CameraMaxZoomDistance = 13.5
		end)
		Feature._runService.RenderStepped:Wait()
		if generation ~= Feature._generation or not Feature._enabled then
			return
		end
		pcall(function()
			player.CameraMaxZoomDistance = 99999
			player.CameraMinZoomDistance = 0.5
			player.CameraMode = Enum.CameraMode.Classic
		end)
	end)
	Feature._trackTask(thread)
end

-- ============================================
-- WEAPON EQUIPPING
-- ============================================

function Feature._equipWeapon()
	local remote
	local success = pcall(function()
		remote = Feature._replicatedStorage:WaitForChild("Remotes"):WaitForChild("BuyOrEquipWeapon")
	end)
	if not success or not remote then
		return false
	end
	for attempt = 1, Feature._config.EQUIP_ATTEMPTS do
		if not Feature._enabled then
			return false
		end
		local fired = pcall(function()
			remote:FireServer(Feature._config.WEAPON_NAME)
		end)
		if fired then
			Feature._invalidateGunCache()
			return true
		end
		task.wait(0.1)
	end
	return false
end

-- ============================================
-- AIMBOT LOOP
-- ============================================

function Feature._startAimbot()
	Feature._stopAimbotLoop()
	Feature._lastFireTime = 0
	local generation = Feature._generation
	local connection = Feature._runService.RenderStepped:Connect(function()
		if generation ~= Feature._generation or not Feature._enabled then
			return
		end
		Feature._updateFOVVisualization()
		if not Feature._aimbotEnabled then
			return
		end
		local target = Feature._getBestTarget()
		local player = Feature._players.LocalPlayer
		local playerCharacter = player and player.Character
		if not target or not target.Parent or not playerCharacter then
			return
		end
		local camera = Feature._workspace.CurrentCamera
		if not camera then
			return
		end
		local currentPosition = camera.CFrame.Position
		local targetPosition = target.Position
		local offset = targetPosition - currentPosition
		local magnitude = offset.Magnitude
		if magnitude <= 0 then
			return
		end
		local desiredLook = offset / magnitude
		pcall(function()
			camera.CFrame = CFrame.new(currentPosition, currentPosition + desiredLook)
		end)
		local currentTime = os.clock()
		if currentTime - Feature._lastFireTime >= Feature._config.FIRE_RATE then
			if Feature._triggerGunFire() then
				Feature._lastFireTime = currentTime
			end
		end
	end)
	Feature._aimbotRenderConnection = connection
	Feature._trackConnection(connection)
end

function Feature._stopAimbotLoop()
	local connection = Feature._aimbotRenderConnection
	Feature._aimbotRenderConnection = nil
	if connection then
		Feature._safeDisconnect(connection)
		for index = #Feature._connections, 1, -1 do
			if Feature._connections[index] == connection then
				table.remove(Feature._connections, index)
				break
			end
		end
	end
end

-- ============================================
-- FOV / STATE CONTROLS
-- ============================================

function Feature._setAimbotEnabled(enabled)
	enabled = enabled == true
	Feature._aimbotEnabled = enabled
	if enabled then
		Feature._invalidateGunCache()
		if not Feature._equipWeapon() then
			Feature._aimbotEnabled = false
			Feature._updateGUI()
			return
		end
		Feature._setFPP(true)
		Feature._startAimbot()
	else
		Feature._stopAimbotLoop()
		Feature._lastFireTime = 0
		Feature._targetCache.part = nil
		Feature._targetCache.time = 0
		Feature._setFPP(false)
	end
	Feature._updateGUI()
end

function Feature._setFOVVisible(enabled)
	Feature._showFOV = enabled == true
	if not Feature._showFOV then
		Feature._hidePool(Feature._fovLines)
		Feature._hidePool(Feature._fovExtraLines)
	end
	Feature._updateGUI()
end

function Feature._setFOV(value)
	value = tonumber(value)
	if not value then
		return
	end
	Feature._fov = math.clamp(value, Feature._config.FOV_MIN, Feature._config.FOV_MAX)
	Feature._updateGUI()
end

-- ============================================
-- GUI UPDATE
-- ============================================

function Feature._updateGUI()
	local elements = Feature._guiElements
	if elements.mainToggle then
		pcall(function()
			elements.mainToggle.Text = Feature._aimbotEnabled and "ON" or "OFF"
			elements.mainToggle.BackgroundColor3 = Feature._aimbotEnabled and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(200, 50, 50)
		end)
	end
	if elements.fovToggle then
		pcall(function()
			elements.fovToggle.BackgroundColor3 = Feature._showFOV and Color3.fromRGB(255, 80, 0) or Color3.fromRGB(80, 80, 80)
			elements.fovToggle.Text = "F"
		end)
	end
	if elements.fovAngleLabel then
		pcall(function()
			elements.fovAngleLabel.Text = Feature._fov .. "°"
		end)
	end
	if elements.sliderFill and elements.sliderKnob then
		local percent = (Feature._fov - Feature._config.FOV_MIN) / (Feature._config.FOV_MAX - Feature._config.FOV_MIN)
		percent = math.clamp(percent, 0, 1)
		pcall(function()
			elements.sliderFill.Size = UDim2.new(percent, 0, 1, 0)
			elements.sliderKnob.Position = UDim2.new(percent, 0, 0.5, 0)
		end)
	end
end

-- ============================================
-- GUI SLIDER
-- ============================================

function Feature._updateSliderFromX(mouseX)
	local elements = Feature._guiElements
	local track = elements.sliderTrack
	if not track then
		return
	end
	local trackPosition = track.AbsolutePosition.X
	local trackSize = track.AbsoluteSize.X
	if trackSize <= 0 then
		return
	end
	local percent = math.clamp((mouseX - trackPosition) / trackSize, 0, 1)
	local angle = Feature._config.FOV_MIN + (Feature._config.FOV_MAX - Feature._config.FOV_MIN) * percent
	angle = math.floor(angle + 0.5)
	Feature._setFOV(angle)
end

function Feature._toggleFOVSlider()
	local slider = Feature._guiElements.fovSlider
	if not slider then
		return
	end
	slider.Visible = not slider.Visible
	if slider.Visible then
		Feature._updateGUI()
	end
end

function Feature._sinkCameraInput(_, inputState)
	if inputState == Enum.UserInputState.Begin or inputState == Enum.UserInputState.Change or inputState == Enum.UserInputState.End then
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

function Feature._startSliderCapture()
	pcall(function()
		Feature._contextActionService:BindActionAtPriority(Feature._sliderActionName, function(...)
			return Feature._sinkCameraInput(...)
		end, false, Enum.ContextActionPriority.High.Value, Enum.UserInputType.MouseMovement, Enum.UserInputType.MouseButton1, Enum.UserInputType.Touch)
	end)
end

function Feature._stopSliderCapture()
	pcall(function()
		Feature._contextActionService:UnbindAction(Feature._sliderActionName)
	end)
	Feature._sliderDragging = false
end

