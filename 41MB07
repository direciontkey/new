	Feature._trackConnection(sliderTrack.InputBegan:Connect(function(input)
		if not Feature._enabled then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Feature._sliderDragging = true
			Feature._startSliderCapture()
			Feature._updateSliderFromX(input.Position.X)
