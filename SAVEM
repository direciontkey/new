-- ============================================
-- SAVE MANAGER
-- ============================================

local HttpService = game:GetService("HttpService")

local SaveManager = {
	NAME = "Save Manager",

	File = "FeatureManager.json",

	Features = {},

	Main = nil,
	MiniButton = nil,

	CurrentThemeName = nil,
	SavedThemeName = nil,

	Loaded = false,

	_connections = {},
	_instances = {},
	_tasks = {},
}

-- ============================================
-- Executor Compatibility
-- ============================================

local cloneref = cloneref
	or clonereference
	or function(instance)
		return instance
	end

local clonefunction = clonefunction
	or copyfunction
	or function(func)
		return func
	end

local writefileFunction =
	type(writefile) == "function"
	and clonefunction(writefile)
	or nil

local readfileFunction =
	type(readfile) == "function"
	and clonefunction(readfile)
	or nil

local isfileFunction =
	type(isfile) == "function"
	and clonefunction(isfile)
	or nil

-- ============================================
-- Helpers
-- ============================================

local function canUseFileSystem()
	return
		type(writefileFunction) == "function"
		and type(readfileFunction) == "function"
		and type(isfileFunction) == "function"
end

local function safeIsFile(path)
	if not canUseFileSystem() then
		return false
	end

	local success, result = pcall(function()
		return isfileFunction(path)
	end)

	return success and result == true
end

local function safeReadFile(path)
	if not canUseFileSystem() then
		return nil
	end

	local success, result = pcall(function()
		return readfileFunction(path)
	end)

	if not success then
		return nil
	end

	return result
end

local function safeWriteFile(path, data)
	if not canUseFileSystem() then
		return false
	end

	local success = pcall(function()
		writefileFunction(path, data)
	end)

	return success
end

local function encode(data)
	local success, result = pcall(function()
		return HttpService:JSONEncode(data)
	end)

	if not success then
		return nil
	end

	return result
end

local function decode(data)
	local success, result = pcall(function()
		return HttpService:JSONDecode(data)
	end)

	if not success or type(result) ~= "table" then
		return nil
	end

	return result
end

-- ============================================
-- Feature State
-- ============================================

function SaveManager:SetFeatures(features)
	if type(features) ~= "table" then
		self.Features = {}
		return
	end

	self.Features = features
end

-- ============================================
-- Window References
-- ============================================

function SaveManager:SetWindow(main, miniButton)
	self.Main = main
	self.MiniButton = miniButton
end

-- ============================================
-- Theme
-- ============================================

function SaveManager:SetTheme(themeName)
	if type(themeName) ~= "string" then
		return false
	end

	self.CurrentThemeName = themeName

	return true
end

function SaveManager:GetTheme()
	return self.CurrentThemeName
end

function SaveManager:GetSavedTheme()
	return self.SavedThemeName
end

-- ============================================
-- Config Existence
-- ============================================

function SaveManager:DoesConfigExist()
	return safeIsFile(self.File)
end

-- ============================================
-- Build Save Data
-- ============================================

function SaveManager:_buildSaveData()
	local data = {
		theme = self.CurrentThemeName,
		objects = {},
		window = {},
	}

	-- ----------------------------------------
	-- Feature states
	-- ----------------------------------------

	if type(self.Features) == "table" then
		for index, feature in pairs(self.Features) do
			if type(feature) == "table" then
				local enabled = false

				if type(feature.isEnabled) == "function" then
					local success, result = pcall(function()
						return feature:isEnabled()
					end)

					if success then
						enabled = result == true
					end
				end

				local key

				if type(index) == "number" then
					key = tostring(index)
				elseif type(index) == "string" then
					key = index
				end

				if key then
					data.objects[key] = enabled
				end
			elseif type(index) == "string" then
				data.objects[index] = feature == true
			end
		end
	end

	-- ----------------------------------------
	-- Main window
	-- ----------------------------------------

	if self.Main then
		local success, position, size = pcall(function()
			return self.Main.Position, self.Main.Size
		end)

		if success then
			data.window.position = {
				scaleX = position.X.Scale,
				offsetX = position.X.Offset,
				scaleY = position.Y.Scale,
				offsetY = position.Y.Offset,
			}

			data.window.size = {
				scaleX = size.X.Scale,
				offsetX = size.X.Offset,
				scaleY = size.Y.Scale,
				offsetY = size.Y.Offset,
			}
		end
	end

	-- ----------------------------------------
	-- Mini button
	-- ----------------------------------------

	if self.MiniButton then
		local success, position = pcall(function()
			return self.MiniButton.Position
		end)

		if success then
			data.window.miniPosition = {
				scaleX = position.X.Scale,
				offsetX = position.X.Offset,
				scaleY = position.Y.Scale,
				offsetY = position.Y.Offset,
			}
		end
	end

	return data
end

-- ============================================
-- Save
-- ============================================

function SaveManager:Save()
	if not canUseFileSystem() then
		return false
	end

	local data = self:_buildSaveData()
	local encoded = encode(data)

	if not encoded then
		warn("[Save Manager] Failed to encode save data.")
		return false
	end

	local success = safeWriteFile(self.File, encoded)

	if not success then
		warn("[Save Manager] Failed to write save file.")
		return false
	end

	self.SavedThemeName = self.CurrentThemeName

	return true
end

-- ============================================
-- Load
-- ============================================

function SaveManager:Load()
	if not safeIsFile(self.File) then
		return false, nil
	end

	local contents = safeReadFile(self.File)

	if not contents then
		return false, nil
	end

	local data = decode(contents)

	if not data then
		warn("[Save Manager] Failed to decode save file.")
		return false, nil
	end

	self.Loaded = true

	-- ----------------------------------------
	-- Saved theme
	-- ----------------------------------------

	if type(data.theme) == "string" then
		self.SavedThemeName = data.theme
	end

	-- ----------------------------------------
	-- Window
	-- ----------------------------------------

	if type(data.window) == "table" then
		local window = data.window

		if self.Main then
			if type(window.position) == "table" then
				local p = window.position

				if
					type(p.scaleX) == "number"
					and type(p.offsetX) == "number"
					and type(p.scaleY) == "number"
					and type(p.offsetY) == "number"
				then
					pcall(function()
						self.Main.Position = UDim2.new(
							p.scaleX,
							p.offsetX,
							p.scaleY,
							p.offsetY
						)
					end)
				end
			end

			if type(window.size) == "table" then
				local s = window.size

				if
					type(s.scaleX) == "number"
					and type(s.offsetX) == "number"
					and type(s.scaleY) == "number"
					and type(s.offsetY) == "number"
				then
					pcall(function()
						self.Main.Size = UDim2.new(
							s.scaleX,
							s.offsetX,
							s.scaleY,
							s.offsetY
						)
					end)
				end
			end
		end

		if self.MiniButton and type(window.miniPosition) == "table" then
			local p = window.miniPosition

			if
				type(p.scaleX) == "number"
				and type(p.offsetX) == "number"
				and type(p.scaleY) == "number"
				and type(p.offsetY) == "number"
			then
				pcall(function()
					self.MiniButton.Position = UDim2.new(
						p.scaleX,
						p.offsetX,
						p.scaleY,
						p.offsetY
					)
				end)
			end
		end
	end

	return true, data
end

-- ============================================
-- Autoload
-- ============================================

function SaveManager:LoadAutoloadConfig()
	return self:Load()
end

-- ============================================
-- Lifecycle Compatibility
-- ============================================

function SaveManager:enable()
	return true
end

function SaveManager:disable()
	return true
end

function SaveManager:isEnabled()
	return true
end

function SaveManager:cleanup()
	for _, connection in pairs(self._connections) do
		if connection then
			pcall(function()
				connection:Disconnect()
			end)
		end
	end

	table.clear(self._connections)

	for _, instance in pairs(self._instances) do
		if instance then
			pcall(function()
				instance:Destroy()
			end)
		end
	end

	table.clear(self._instances)

	table.clear(self._tasks)

	self.Features = {}

	self.Main = nil
	self.MiniButton = nil

	self.CurrentThemeName = nil
	self.SavedThemeName = nil
	self.Loaded = false
end

return SaveManager
