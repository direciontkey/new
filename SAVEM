-- ============================================
-- SAVE MANAGER
-- ============================================

local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")

local SaveManager = {
	NAME = "Save Manager",

	Folder = "GAME CONFIGS",
	File = nil,

	Features = {},

	Main = nil,
	MiniButton = nil,

	Popup = nil,
	PopupFeatureIndex = nil,

	CurrentThemeName = nil,
	SavedThemeName = nil,

	Loaded = false,

	_connections = {},
	_instances = {},
	_tasks = {},
}

-- ============================================
-- EXECUTOR WRAPPERS
-- ============================================

local function getFunction(name)
	local success, result = pcall(function()
		return getgenv()[name]
	end)

	if success and type(result) == "function" then
		return result
	end

	return nil
end

local cloneref = getFunction("cloneref")
local clonefunction = getFunction("clonefunction")

local writefile = getFunction("writefile")
local readfile = getFunction("readfile")
local isfile = getFunction("isfile")
local makefolder = getFunction("makefolder")
local isfolder = getFunction("isfolder")

if clonefunction then
	writefile = writefile and clonefunction(writefile) or writefile
	readfile = readfile and clonefunction(readfile) or readfile
	isfile = isfile and clonefunction(isfile) or isfile
	makefolder = makefolder and clonefunction(makefolder) or makefolder
	isfolder = isfolder and clonefunction(isfolder) or isfolder
end

if cloneref then
	HttpService = cloneref(HttpService)
	MarketplaceService = cloneref(MarketplaceService)
end

-- ============================================
-- FILESYSTEM HELPERS
-- ============================================

local function safeIsFolder(path)
	if type(isfolder) ~= "function" then
		return false
	end

	local success, result = pcall(isfolder, path)
	return success and result == true
end

local function safeMakeFolder(path)
	if type(makefolder) ~= "function" then
		return false
	end

	local success = pcall(makefolder, path)
	return success
end

local function safeIsFile(path)
	if type(isfile) ~= "function" then
		return false
	end

	local success, result = pcall(isfile, path)
	return success and result == true
end

local function safeReadFile(path)
	if type(readfile) ~= "function" then
		return nil
	end

	local success, result = pcall(readfile, path)

	if success and type(result) == "string" then
		return result
	end

	return nil
end

local function safeWriteFile(path, content)
	if type(writefile) ~= "function" then
		return false
	end

	local success = pcall(writefile, path, content)
	return success
end

-- ============================================
-- GAME NAME
-- ============================================

local function getGameName()
	local success, result = pcall(function()
		return MarketplaceService:GetProductInfo(game.PlaceId).Name
	end)

	if success and type(result) == "string" and result ~= "" then
		return result
	end

	return tostring(game.PlaceId)
end

-- ============================================
-- SANITIZE GAME NAME
-- ============================================

local function sanitizeName(name)
	name = tostring(name or "")

	name = name:gsub("[<>:\"/\\|%?%*]", "_")
	name = name:gsub("[%c]", "_")

	if name == "" then
		name = "Unknown Game"
	end

	return name
end

-- ============================================
-- JSON HELPERS
-- ============================================

local function encodeJSON(data)
	local success, result = pcall(function()
		return HttpService:JSONEncode(data)
	end)

	if success then
		return result
	end

	return nil
end

local function decodeJSON(data)
	local success, result = pcall(function()
		return HttpService:JSONDecode(data)
	end)

	if success and type(result) == "table" then
		return result
	end

	return nil
end

-- ============================================
-- PATH
-- ============================================

function SaveManager:GetPath()
	local gameName = sanitizeName(getGameName())

	return self.Folder .. "/" .. gameName .. ".json"
end

-- ============================================
-- FEATURES
-- ============================================

function SaveManager:SetFeatures(features)
	if type(features) ~= "table" then
		self.Features = {}
		return
	end

	self.Features = features
end

-- ============================================
-- WINDOW REFERENCES
-- ============================================

function SaveManager:SetWindow(main, miniButton)
	self.Main = main
	self.MiniButton = miniButton
end

-- ============================================
-- POPUP REFERENCE
-- ============================================

function SaveManager:SetPopup(popupFrame, featureIndex)
	self.Popup = popupFrame
	self.PopupFeatureIndex = featureIndex

	return true
end

function SaveManager:ClearPopup()
	self.Popup = nil
	self.PopupFeatureIndex = nil
end

-- ============================================
-- THEME
-- ============================================

function SaveManager:SetTheme(themeName)
	if type(themeName) ~= "string" then
		return false
	end

	self.CurrentThemeName = themeName

	return true
end

function SaveManager:GetTheme()
	return self.CurrentThemeName
end

function SaveManager:GetSavedTheme()
	return self.SavedThemeName
end

-- ============================================
-- BUILD SAVE DATA
-- ============================================

function SaveManager:_buildSaveData()
	local data = {
		theme = self.CurrentThemeName,
		objects = {},
		window = {},
		popup = {
			active = false,
			featureIndex = nil,
			position = nil,
		},
	}

	-- ============================================
	-- FEATURE STATES
	-- ============================================

	for featureIndex, feature in pairs(self.Features) do
		if type(feature) == "table" and type(feature.isEnabled) == "function" then
			local success, enabled = pcall(function()
				return feature:isEnabled()
			end)

			if success then
				data.objects[tostring(featureIndex)] = enabled == true
			end
		end
	end

	-- ============================================
	-- MAIN WINDOW POSITION / SIZE
	-- ============================================

	if self.Main and self.Main.Parent then
		local positionSuccess, position = pcall(function()
			return self.Main.Position
		end)

		if positionSuccess and position then
			data.window.position = {
				scaleX = position.X.Scale,
				offsetX = position.X.Offset,
				scaleY = position.Y.Scale,
				offsetY = position.Y.Offset,
			}
		end

		local sizeSuccess, size = pcall(function()
			return self.Main.Size
		end)

		if sizeSuccess and size then
			data.window.size = {
				scaleX = size.X.Scale,
				offsetX = size.X.Offset,
				scaleY = size.Y.Scale,
				offsetY = size.Y.Offset,
			}
		end
	end

	-- ============================================
	-- MINI BUTTON POSITION
	-- ============================================

	if self.MiniButton and self.MiniButton.Parent then
		local success, position = pcall(function()
			return self.MiniButton.Position
		end)

		if success and position then
			data.window.miniPosition = {
				scaleX = position.X.Scale,
				offsetX = position.X.Offset,
				scaleY = position.Y.Scale,
				offsetY = position.Y.Offset,
			}
		end
	end

	-- ============================================
	-- POPUP STATE / POSITION
	-- ============================================

	if self.Popup and self.Popup.Parent then
		local success, position = pcall(function()
			return self.Popup.Position
		end)

		if success and position then
			data.popup.active = true
			data.popup.featureIndex = self.PopupFeatureIndex

			data.popup.position = {
				scaleX = position.X.Scale,
				offsetX = position.X.Offset,
				scaleY = position.Y.Scale,
				offsetY = position.Y.Offset,
			}
		end
	end

	return data
end

-- ============================================
-- SAVE
-- ============================================

function SaveManager:Save()
	if not safeIsFolder(self.Folder) then
		safeMakeFolder(self.Folder)
	end

	local data = self:_buildSaveData()
	local encoded = encodeJSON(data)

	if not encoded then
		return false
	end

	local path = self:GetPath()

	if not safeWriteFile(path, encoded) then
		return false
	end

	self.SavedThemeName = self.CurrentThemeName

	return true
end

-- ============================================
-- LOAD
-- ============================================

function SaveManager:Load()
	if not safeIsFile(self:GetPath()) then
		return false, nil
	end

	local content = safeReadFile(self:GetPath())

	if not content then
		return false, nil
	end

	local data = decodeJSON(content)

	if type(data) ~= "table" then
		return false, nil
	end

	-- ============================================
	-- THEME
	-- ============================================

	if type(data.theme) == "string" then
		self.SavedThemeName = data.theme
		self.CurrentThemeName = data.theme
	end

	-- ============================================
	-- MAIN WINDOW POSITION
	-- ============================================

	if self.Main and self.Main.Parent then
		local position = data.window and data.window.position

		if type(position) == "table"
			and type(position.scaleX) == "number"
			and type(position.offsetX) == "number"
			and type(position.scaleY) == "number"
			and type(position.offsetY) == "number"
		then
			pcall(function()
				self.Main.Position = UDim2.new(
					position.scaleX,
					position.offsetX,
					position.scaleY,
					position.offsetY
				)
			end)
		end

		-- ============================================
		-- MAIN WINDOW SIZE
		-- ============================================

		local size = data.window and data.window.size

		if type(size) == "table"
			and type(size.scaleX) == "number"
			and type(size.offsetX) == "number"
			and type(size.scaleY) == "number"
			and type(size.offsetY) == "number"
		then
			pcall(function()
				self.Main.Size = UDim2.new(
					size.scaleX,
					size.offsetX,
					size.scaleY,
					size.offsetY
				)
			end)
		end
	end

	-- ============================================
	-- MINI BUTTON POSITION
	-- ============================================

	if self.MiniButton and self.MiniButton.Parent then
		local miniPosition = data.window and data.window.miniPosition

		if type(miniPosition) == "table"
			and type(miniPosition.scaleX) == "number"
			and type(miniPosition.offsetX) == "number"
			and type(miniPosition.scaleY) == "number"
			and type(miniPosition.offsetY) == "number"
		then
			pcall(function()
				self.MiniButton.Position = UDim2.new(
					miniPosition.scaleX,
					miniPosition.offsetX,
					miniPosition.scaleY,
					miniPosition.offsetY
				)
			end)
		end
	end

	-- ============================================
	-- POPUP DATA
	-- ============================================

	if type(data.popup) == "table" then
		if data.popup.active == true
			and type(data.popup.featureIndex) == "number"
		then
			-- Store the saved popup information so Feature Manager
			-- can recreate the popup after all UI objects exist.
			self.PopupFeatureIndex = data.popup.featureIndex
		else
			self.PopupFeatureIndex = nil
		end
	end

	self.Loaded = true

	return true, data
end

-- ============================================
-- AUTOLOAD CONFIG
-- ============================================

function SaveManager:LoadAutoloadConfig()
	return self:Load()
end

-- ============================================
-- CLEANUP
-- ============================================

function SaveManager:Cleanup()
	for _, connection in pairs(self._connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	for _, instance in pairs(self._instances) do
		pcall(function()
			instance:Destroy()
		end)
	end

	for _, taskObject in pairs(self._tasks) do
		pcall(function()
			task.cancel(taskObject)
		end)
	end

	self._connections = {}
	self._instances = {}
	self._tasks = {}

	self.Popup = nil
	self.PopupFeatureIndex = nil

	self.Main = nil
	self.MiniButton = nil
end

return SaveManager
